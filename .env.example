# SQL Server
DATABASE_HOST=172.0.1.156
DATABASE_PORT=1433
DATABASE_NAME=PruebasRmanD2
DATABASE_USER=sql_agent_reader
DATABASE_PASSWORD=CAMBIAR_PASSWORD
# false en producción si el certificado/CA es confiable. true solo para certificados no confiables.
DATABASE_TRUST_CERT=true

# Ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_TEMPERATURE=0.0

# Agent / limits
MAX_STEPS=8
MAX_SQL_LENGTH=10000
MAX_ROWS=100
MAX_RESULT_CHARS=30000
SCHEMA_CACHE_SECONDS=300
QUERY_TIMEOUT_SECONDS=30
MAX_CONCURRENT_QUERIES=1
MAX_JOINS=5
MAX_SUBQUERIES=5
MAX_SCHEMA_RESULTS=20
MAX_TOOL_RESULT_CHARS=20000
MAX_TOOL_CALLS_PER_STEP=2

# Si se deja vacío, se permiten las tablas a las que el login tenga SELECT.
# Recomendado en producción: enumerar explícitamente las tablas.
ALLOWED_TABLES=dbo.entradaLote
# Aliases descontinuados (mantener compatibilidad, muestran warning):
# BLOCKED_TABLES=dbo.entradaLote
# BLOCKED_COLUMNS=dbo.entradaLote
# MAX_AGENT_STEPS=8

BLOCK_SENSITIVE_COLUMNS=true
BLOCK_COMMENTS=true
ALLOW_CTE=true
ALLOW_SYSTEM_TABLES=false

# Auditoría
AUDIT_ENABLED=true
AUDIT_PATH=logs/agent-audit.jsonl
AUDIT_SQL=true
