# SQL Server
DATABASE_HOST=db_ip_host
DATABASE_PORT=1433
DATABASE_NAME=dbname
DATABASE_USER=sql_agent_reader
DATABASE_PASSWORD=CAMBIAR_PASSWORD
# false by default: only set true explicitly for dev with untrusted certs.
DATABASE_TRUST_CERT=false

# LLM provider: ollama, openai, google/gemini, or anthropic/claude
LLM_PROVIDER=ollama
# Single credential variable shared by the selected provider.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Ollama (local, no credential required)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_TEMPERATURE=0.0

# OpenAI
# LLM_API_KEY=CAMBIAR_API_KEY
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini

# Google Gemini
# LLM_API_KEY=CAMBIAR_API_KEY
# LLM_PROVIDER=google
# LLM_MODEL=gemini-2.0-flash

# Anthropic Claude
# LLM_API_KEY=CAMBIAR_API_KEY
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-5-haiku-latest

# Agent / limits
MAX_STEPS=8
MAX_SQL_LENGTH=10000
MAX_ROWS=100
SCHEMA_CACHE_SECONDS=300
QUERY_TIMEOUT_SECONDS=30
MAX_CONCURRENT_QUERIES=1
MAX_JOINS=5
MAX_SUBQUERIES=5
MAX_SCHEMA_RESULTS=20
MAX_TOOL_RESULT_CHARS=20000
MAX_TOOL_CALLS_PER_STEP=2

# Si se deja vacío, se permiten las tablas a las que el login tenga SELECT.
# Recomendado en producción: enumerar explícitamente las tablas.
ALLOWED_TABLES=dbo.entradaLote
# Aliases descontinuados (mantener compatibilidad, muestran warning):
# BLOCKED_TABLES=dbo.entradaLote
# BLOCKED_COLUMNS=dbo.entradaLote
# MAX_AGENT_STEPS=8

BLOCK_SENSITIVE_COLUMNS=true
BLOCK_COMMENTS=true
ALLOW_CTE=true
ALLOW_SYSTEM_TABLES=false

# Auditoría
AUDIT_ENABLED=true
AUDIT_PATH=logs/agent-audit.jsonl
# Audit SQL text may contain PII: keep false unless explicitly needed.
AUDIT_SQL=false
